# Output del build (se regenera en cada corrida; nunca se commitea)
dist/

# Modelo ONNX (~22 MB) + tokenizer.json: se descargan en CI o build local (Paso 2).
# Ignoramos el directorio entero (nada de models/ va al repo).
models/

# Dependencias JS del gate de equivalencia (Paso 4). El SITIO no las necesita
# (usa el import map al CDN); se instalan solo para `node --test` en Node/CI.
node_modules/

# Cache de modelos que Transformers.js baja en Node para el equivalence test.
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
