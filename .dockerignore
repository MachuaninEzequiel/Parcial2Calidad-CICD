# Lo que NO entra al build context (lo pesado/innecesario). El build los
# regenera/instala/hornea adentro de la imagen:
#   - models/  → lo baja download_model.py
#   - dist/    → lo genera vectorize.py
#   - node_modules/ → lo instala npm ci

# Pesado / regenerable
node_modules
models
dist
.cache

# Git y metadata de herramientas
.git
.gitignore
.github
.cortex
.claude

# Recetario para "romper el CI" (carpetas locales, gitignored, NO son parte del
# proyecto). El CI real nunca las ve (hace checkout de git); las excluimos del
# build context para que `docker run ... ci` corra igual de limpio en local.
romper-ci
romper-ci-2

# Docs de exposición (no afectan el build ni los tests)
docs-expo

# Python
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.ruff_cache
.pytest_cache

# Editores / SO
.vscode
.idea
.DS_Store
Thumbs.db
